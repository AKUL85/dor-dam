import type { Metadata } from "next";
import Link from "next/link";
import { notFound } from "next/navigation";
import { fetchPhone, fetchPhones } from "@/lib/api";
import SpecTable from "@/components/SpecTable";
import PhoneCard from "@/components/PhoneCard";
import ImageGallery from "@/components/ImageGallery";

interface Props {
  params: Promise<{ slug: string }>;
}

export async function generateMetadata({ params }: Props): Promise<Metadata> {
  const { slug } = await params;
  const phone = await fetchPhone(slug).catch(() => null);
  if (!phone) return { title: "Phone Not Found" };
  return {
    title: phone.modelName,
    description: `${phone.modelName} specifications — ${phone.keySpecs.display || ""}, ${phone.keySpecs.chipset || ""}, ${phone.keySpecs.battery || ""} battery, ${phone.keySpecs.camera || ""} camera.`,
  };
}

export default async function PhoneDetailPage({ params }: Props) {
  const { slug } = await params;
  const phone = await fetchPhone(slug);
  if (!phone) notFound();

  // Related phones (same brand, excluding current)
  const related = await fetchPhones({ brand: phone.brand, pageSize: 7, sort: "popularity" }).catch(() => null);
  const relatedPhones = related?.items.filter((p) => p.slug !== phone.slug).slice(0, 6) ?? [];

  // Quick specs for the hero section
  const quickItems = [
    { label: "Display", value: phone.keySpecs.display?.split(",")[0], icon: "📱" },
    { label: "Chipset", value: phone.keySpecs.chipset?.split("(")[0]?.trim(), icon: "⚡" },
    { label: "RAM", value: phone.keySpecs.ram, icon: "🧠" },
    { label: "Storage", value: phone.keySpecs.storage?.split(",")[0]?.split("storage")[0]?.trim(), icon: "💾" },
    { label: "Battery", value: phone.keySpecs.battery, icon: "🔋" },
    { label: "Camera", value: phone.keySpecs.camera?.split(",")[0], icon: "📷" },
    { label: "OS", value: phone.keySpecs.os?.split(",")[0], icon: "⚙️" },
    { label: "Network", value: phone.keySpecs.network, icon: "📡" },
  ].filter((i) => i.value);

  return (
    <div className="animate-fade-in">
      {/* ═══ Hero ═══ */}
      <section className="relative overflow-hidden border-b border-white/[0.04]">
        {/* Background glow */}
        <div className="pointer-events-none absolute -top-20 left-1/2 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-blue-600/[0.05] blur-[100px]" />

        <div className="relative mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:py-14">
          {/* Breadcrumb */}
          <nav className="mb-6 flex items-center gap-2 text-sm text-slate-500">
            <Link href="/" className="transition hover:text-slate-300">Home</Link>
            <span>/</span>
            <Link href={`/phones?brand=${encodeURIComponent(phone.brand)}`} className="transition hover:text-slate-300">
              {phone.brand}
            </Link>
            <span>/</span>
            <span className="text-slate-300">{phone.modelName}</span>
          </nav>

          <div className="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
            {/* Image */}
            <div className="flex shrink-0 flex-col items-center justify-start lg:w-80">
              {phone.pictures && phone.pictures.length > 0 ? (
                <ImageGallery images={phone.pictures} altText={phone.modelName} />
              ) : (
                <div className="relative flex h-80 w-full max-w-sm items-center justify-center rounded-2xl bg-gradient-to-b from-slate-800/30 to-transparent p-8">
                  {phone.imageUrl ? (
                    // eslint-disable-next-line @next/next/no-img-element
                    <img
                      src={phone.imageUrl}
                      alt={phone.modelName}
                      className="h-auto max-h-72 w-auto drop-shadow-2xl"
                    />
                  ) : (
                    <div className="flex h-60 w-44 items-center justify-center rounded-xl bg-slate-700/30 text-slate-500">
                      <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
                        <line x1="12" y1="18" x2="12.01" y2="18" />
                      </svg>
                    </div>
                  )}
                </div>
              )}
            </div>

            {/* Info */}
            <div className="flex-1">
              <div className="flex flex-wrap items-center gap-3">
                <span className="rounded-full bg-blue-500/15 px-3 py-1 text-xs font-semibold text-blue-300">
                  {phone.brand}
                </span>
                {phone.releaseYear && (
                  <span className="rounded-full bg-white/[0.06] px-3 py-1 text-xs text-slate-400">
                    {phone.releaseYear}
                  </span>
                )}
                {phone.status && (
                  <span className={`rounded-full px-3 py-1 text-xs font-medium ${
                    phone.status.toLowerCase().includes("available")
                      ? "bg-emerald-500/15 text-emerald-400"
                      : "bg-amber-500/15 text-amber-400"
                  }`}>
                    {phone.status.split(".")[0]}
                  </span>
                )}
              </div>

              <h1 className="mt-3 text-3xl font-bold text-white sm:text-4xl">
                {phone.modelName}
              </h1>

              {phone.releaseDate && (
                <p className="mt-2 text-sm text-slate-400">{phone.releaseDate}</p>
              )}

              {phone.priceHint && (
                <p className="mt-3 text-lg font-semibold text-emerald-400">
                  {phone.priceHint}
                </p>
              )}

              {/* Quick spec grid */}
              <div className="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {quickItems.map((item) => (
                  <div
                    key={item.label}
                    className="rounded-xl border border-white/[0.06] bg-[#1a2235] px-3.5 py-3"
                  >
                    <span className="text-base">{item.icon}</span>
                    <p className="mt-1 text-xs text-slate-500">{item.label}</p>
                    <p className="mt-0.5 text-sm font-medium text-white leading-snug">{item.value}</p>
                  </div>
                ))}
              </div>

              {/* Actions */}
              <div className="mt-6 flex flex-wrap gap-3">
                <Link
                  href={`/compare?slugs=${phone.slug}`}
                  className="inline-flex items-center gap-2 rounded-lg bg-blue-500 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-blue-500/20 transition hover:bg-blue-600 hover:shadow-lg hover:shadow-blue-500/30"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                    <path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" />
                  </svg>
                  Compare
                </Link>
                {phone.detailUrl && (
                  <a
                    href={phone.detailUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="inline-flex items-center gap-2 rounded-lg border border-white/[0.1] bg-white/[0.04] px-5 py-2.5 text-sm font-medium text-slate-300 transition hover:bg-white/[0.08] hover:text-white"
                  >
                    View on GSMArena
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ═══ Full Specifications ═══ */}
      <section className="mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <h2 className="mb-6 text-2xl font-bold text-white">Full Specifications</h2>
        <div className="max-w-4xl">
          <SpecTable specs={phone.specs} />
        </div>
      </section>

      {/* ═══ Related Phones ═══ */}
      {relatedPhones.length > 0 && (
        <section className="mx-auto max-w-7xl px-4 pb-16 sm:px-6">
          <div className="mb-6 flex items-center justify-between">
            <h2 className="text-2xl font-bold text-white">More from {phone.brand}</h2>
            <Link
              href={`/phones?brand=${encodeURIComponent(phone.brand)}`}
              className="text-sm font-medium text-blue-400 transition hover:text-blue-300"
            >
              View all →
            </Link>
          </div>
          <div className="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
            {relatedPhones.map((p) => (
              <PhoneCard key={p.slug} phone={p} />
            ))}
          </div>
        </section>
      )}
    </div>
  );
}
