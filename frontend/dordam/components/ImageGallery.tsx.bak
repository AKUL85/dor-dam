"use client";

import { useState } from "react";

interface ImageGalleryProps {
  images: string[];
  altText: string;
}

export default function ImageGallery({ images, altText }: ImageGalleryProps) {
  const [currentIndex, setCurrentIndex] = useState(0);

  if (!images || images.length === 0) {
    return (
      <div className="flex h-60 w-44 items-center justify-center rounded-xl bg-slate-700/30 text-slate-500">
        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
          <line x1="12" y1="18" x2="12.01" y2="18" />
        </svg>
      </div>
    );
  }

  return (
    <div className="flex flex-col items-center gap-4 w-full">
      {/* Main Image */}
      <div className="relative flex h-80 w-full max-w-sm items-center justify-center rounded-2xl bg-gradient-to-b from-slate-800/30 to-transparent p-4">
        {/* eslint-disable-next-line @next/next/no-img-element */}
        <img
          src={images[currentIndex]}
          alt={`${altText} - picture ${currentIndex + 1}`}
          className="h-full max-h-72 w-auto object-contain drop-shadow-2xl transition-opacity duration-300"
        />
      </div>

      {/* Thumbnails */}
      {images.length > 1 && (
        <div className="flex flex-wrap items-center justify-center gap-2">
          {images.map((img, idx) => (
            <button
              key={idx}
              onClick={() => setCurrentIndex(idx)}
              className={`relative h-16 w-16 overflow-hidden rounded-lg border-2 transition-all ${
                idx === currentIndex
                  ? "border-blue-500 bg-blue-500/10 opacity-100 scale-105"
                  : "border-transparent bg-slate-800/50 opacity-60 hover:opacity-100"
              } p-1`}
              aria-label={`View picture ${idx + 1}`}
            >
              {/* eslint-disable-next-line @next/next/no-img-element */}
              <img
                src={img}
                alt={`${altText} thumbnail ${idx + 1}`}
                className="h-full w-full object-contain"
              />
            </button>
          ))}
        </div>
      )}
    </div>
  );
}
